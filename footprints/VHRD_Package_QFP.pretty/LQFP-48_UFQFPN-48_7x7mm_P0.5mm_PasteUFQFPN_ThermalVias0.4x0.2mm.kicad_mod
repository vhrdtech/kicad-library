	(version 20260206)
	(generator "kicad-footprint-generator")
	(layer "F.Cu")
	(descr "LQFP-48 or UFQFPN-48, 7x7 mm, 0.5 mm pitch, on one land pattern: UFQFPN pads 0.55 long from 6.20 to 7.30 (0.3 mm from the 5.6 mm exposed pad), LQFP pads from 7.88 to 9.70, split by a 0.19 mm mask web and joined by copper under the mask; exposed pad on pin 7 (VSS). Paste for UFQFPN; the other variant has the same copper and the LQFP paste (ST DS13560 Figures 44, 47); 12 tented 0.4/0.2 mm thermal vias in the exposed pad")
